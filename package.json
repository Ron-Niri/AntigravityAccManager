{
  "name": "antigravity-account-manager",
  "displayName": "Antigravity Account Manager",
  "description": "Local multi-account quota dashboard and experimental session switching for Antigravity IDE.",
  "version": "0.5.0",
  "publisher": "Ron-Niri",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "categories": ["Other"],
  "keywords": ["antigravity", "quota", "accounts", "model availability"],
  "extensionKind": ["ui"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ron-Niri/AntigravityAccManager.git"
  },
  "bugs": {
    "url": "https://github.com/Ron-Niri/AntigravityAccManager/issues"
  },
  "homepage": "https://github.com/Ron-Niri/AntigravityAccManager#readme",
  "engines": {
    "vscode": "^1.107.0",
    "node": ">=20"
  },
  "main": "./src/extension.cjs",
  "activationEvents": [
    "onCommand:agm.open",
    "onCommand:agm.openGithub",
    "onView:agm.accounts",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agm.open",
        "title": "Antigravity Accounts: Open Sidebar"
      },
      {
        "command": "agm.refresh",
        "title": "Refresh Accounts",
        "icon": "$(refresh)"
      },
      {
        "command": "agm.connect",
        "title": "Connect Google Account",
        "icon": "$(add)"
      },
      {
        "command": "agm.openGithub",
        "title": "Open GitHub Repository",
        "icon": "$(github)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agm",
          "title": "Antigravity Accounts",
          "icon": "media/accounts.svg"
        }
      ]
    },
    "views": {
      "agm": [
        {
          "type": "webview",
          "id": "agm.accounts",
          "name": "Accounts",
          "contextualTitle": "Antigravity Accounts"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agm.refresh",
          "when": "view == agm.accounts",
          "group": "navigation@1"
        },
        {
          "command": "agm.connect",
          "when": "view == agm.accounts",
          "group": "navigation@2"
        },
        {
          "command": "agm.openGithub",
          "when": "view == agm.accounts",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-icon.cjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links",
    "audit:privacy": "node scripts/audit-privacy.cjs",
    "test": "node --test test/core.test.cjs test/monitor.test.cjs",
    "check": "node --check src/extension.cjs && node --check src/core.cjs && node --check src/oauth.cjs && node --check src/ide-state.cjs && node --check src/switch.cjs && node --check src/monitor.cjs && node --check src/scan.cjs && node --check media/panel.js && node --check media/readiness.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vscode/vsce": "^4.0.0"
  }
}
